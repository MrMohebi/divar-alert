TELEGRAM_BOT_TOKEN=

# Docker Compose: choose a published release tag or sha-<full-commit>.
DIVAR_IMAGE_TAG=

# you can use Bale api or Telegram api
#TELEGRAM_API_URL=https://api.telegram.org
TELEGRAM_API_URL=https://tapi.bale.ai

DB_PATH=./data/divar-alert.db
