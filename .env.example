# Set a token for each platform the bot should serve; both can run together.
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# Optional API URLs (defaults shown).
#TELEGRAM_API_URL=https://api.telegram.org
#BALE_API_URL=https://tapi.bale.ai

# Alerts saved by an earlier single-bot version belong to this platform
# (bale or telegram). Needed only when both tokens are set.
#EXISTING_ALERTS_PLATFORM=bale

# Docker Compose: choose a published release tag or sha-<full-commit>.
DIVAR_IMAGE_TAG=

DB_PATH=./data/divar-alert.db
POLL_INTERVAL_SECONDS=1

# Required for conversational setup; existing alerts still monitor without AI.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
