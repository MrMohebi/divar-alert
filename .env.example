# Set a token for each platform the bot should serve; both can run together.
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# Optional Bot API URLs (defaults shown).
#TELEGRAM_API_URL=https://api.telegram.org
#BALE_API_URL=https://tapi.bale.ai

# Docker Compose: choose a published release tag or sha-<full-commit>.
DIVAR_IMAGE_TAG=

# Version 3 needs a new database; it refuses files from earlier versions.
DB_PATH=./data/divar-alert.db
POLL_INTERVAL_SECONDS=1

# Required for conversational setup and listing analysis; alerts still
# monitor without AI.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
